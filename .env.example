# ─── APPLICATION & PORT ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://admin.dwellr.tech
ALLOWED_ORIGINS=https://admin.dwellr.tech,https://dwellr.tech

# ─── DATABASE (PostgreSQL / Neon / Supabase) ────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dwellr?sslmode=require"

# ─── JWT AUTHENTICATION SECRETS ────────────────────────────────────────────────
JWT_SECRET_USER_ACCESS="your-secure-user-access-jwt-secret"
JWT_SECRET_USER_REFRESH="your-secure-user-refresh-jwt-secret"
JWT_SECRET_ADMIN_ACCESS="your-secure-admin-access-jwt-secret"
JWT_SECRET_ADMIN_REFRESH="your-secure-admin-refresh-jwt-secret"
JWT_SECRET_RESET_ACCESS="your-secure-reset-password-secret"
JWT_SECRET_SUPER_ADMIN_ACCESS="your-secure-super-admin-access-secret"
JWT_SECRET_SUPER_ADMIN_REFRESH="your-secure-super-admin-refresh-secret"

# ─── CLOUDINARY (Asset & Image Uploads) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── EMAIL & NOTIFICATIONS (Resend / SMTP) ─────────────────────────────────────
MAIL_PROVIDER=resend
RESEND_API_KEY="re_123456789"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_USERNAME="notifications@dwellr.tech"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="Dwellr <notifications@dwellr.tech>"
SITE_OWNER_MAIL="abibdipto@gmail.com"

# ─── STRIPE BILLING & WEBHOOKS ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── BRANDING & METADATA ───────────────────────────────────────────────────────
SITE_NAME="Dwellr"
SITE_DESCRIPTION="Intelligent Real Estate Due Diligence & Market Insights Platform"
